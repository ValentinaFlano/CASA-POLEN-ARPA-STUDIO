# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local al repositorio.

# URL pública del sitio, sin "/" final. Se usa en metadatos, Open Graph y sitemap.
# En Vercel: configúrala por entorno (Production / Preview).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Fase 2: contenido (Sanity) ---
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=
# SANITY_REVALIDATE_SECRET=

# --- Fase 2: cotizaciones (Supabase) ---
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=   # solo servidor, nunca en el cliente

# --- Fase 2: correos (Resend) ---
# RESEND_API_KEY=
# CORREO_REMITENTE=            # ej. "Casa Polen <hola@tu-dominio.cl>" (dominio verificado en Resend)
# CORREO_EQUIPO=               # quién recibe los avisos; separa varios con coma

# --- Fase 3: agenda (Google Calendar) ---
# (se documenta al iniciar la Fase 3)
