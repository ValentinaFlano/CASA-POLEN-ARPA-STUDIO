# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local al repositorio.

# URL pública del sitio, sin "/" final. Se usa en metadatos, Open Graph y sitemap.
# En Vercel: configúrala por entorno (Production / Preview).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cotizaciones: base de datos y fotos (Supabase) ---
# Supabase → Project Settings → API. Ejecuta antes supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
# "service_role" (secret). Solo servidor: NUNCA la publiques ni la uses en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cotizaciones: correos (Resend) ---
# Resend → API Keys.
RESEND_API_KEY=
# Remitente. Sin dominio verificado usa "Casa Polen <onboarding@resend.dev>"
# (en ese modo Resend solo entrega a tu propio correo; el acuse al cliente
# empieza a llegar cuando verifiques el dominio).
CORREO_REMITENTE=Casa Polen <onboarding@resend.dev>
# Quién recibe los avisos de cotización. Varios correos separados por coma.
CORREO_EQUIPO=valentinaflanoi22@gmail.com

# --- Fase 3: agenda (Google Calendar) ---
# (se documenta al iniciar la Fase 3)
